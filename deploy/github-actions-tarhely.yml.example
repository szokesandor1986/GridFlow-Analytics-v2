# Alternatív workflow: a GitHub gyűjti az adatot, és FTPS-en feltölti egy webtárhelyre
# (például Rackhost, Hostinger, bármelyik magyar tárhelyszolgáltató).
# A tárhelyen nem kell Python, cron vagy SSH: csak statikus fájlokat szolgál ki.
#
# Használat: másold ezt a fájlt a .github/workflows/update.yml helyére (felülírva az eredetit),
# majd vedd fel a titkokat: FTP_HOST, FTP_USER, FTP_PASS, ENTSOE_TOKEN,
# és ha a feltöltési mappa nem a belépési mappa: FTP_DIR (pl. /public_html vagy /www).
name: Adatfrissítés és feltöltés a tárhelyre

on:
  schedule:
    - cron: "7,27,47 * * * *"
  workflow_dispatch:
  push:
    branches: [main]

permissions:
  contents: read

concurrency:
  group: tarhely
  cancel-in-progress: false

jobs:
  feltoltes:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip

      - name: Függőségek
        run: pip install -r requirements.txt

      - name: Gyűjtő tesztje (kitalált klienssel, hálózat nélkül)
        run: python -I tests/test_collector.py

      - name: Adatgyűjtés az ENTSO-E-ről
        env:
          ENTSOE_TOKEN: ${{ secrets.ENTSOE_TOKEN }}
        run: |
          mkdir -p dist
          python collector.py --out dist/data.json
          cp index.html muszaki.html europa.html foldgaz.html idojaras.html europe-geo.json hu-geo.json demo-*.json dist/
          cp -r assets dist/assets
          for f in history.json gas.json; do [ -f "$f" ] && cp "$f" dist/; done; true

      - name: Feltöltés a tárhelyre (FTPS)
        env:
          FTP_HOST: ${{ secrets.FTP_HOST }}
          FTP_USER: ${{ secrets.FTP_USER }}
          FTP_PASS: ${{ secrets.FTP_PASS }}
          FTP_DIR: ${{ secrets.FTP_DIR }}
        run: python deploy/upload_ftps.py dist
